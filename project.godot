; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="솔바람 마을"
run/main_scene="res://ui/title/title_screen.tscn"
config/features=PackedStringArray("4.5", "Mobile")
run/max_fps=60

[autoload]

Net="*res://autoload/net/net.gd"
GameData="*res://autoload/game_data/game_data.gd"
Audio="*res://autoload/audio/audio.gd"
Quality="*res://autoload/quality/quality.gd"
Economy="*res://autoload/economy/economy.gd"
Field="*res://autoload/field/field.gd"
Home="*res://autoload/home/home.gd"
Talk="*res://autoload/talk/talk.gd"
ScreenFit="*res://autoload/screen/screen_fit.gd"
Journal="*res://autoload/journal/journal.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[gui]

theme/custom="res://ui/theme/game_theme.tres"
theme/custom_font="res://assets/fonts/ui_font.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048

[shader_globals]

world_curve_strength={
"type": "float",
"value": 0.004
}
world_curve_origin={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
toon_softness={
"type": "float",
"value": 0.35
}
world_wetness={
"type": "float",
"value": 0.0
}
night_light={
"type": "float",
"value": 0.0
}
